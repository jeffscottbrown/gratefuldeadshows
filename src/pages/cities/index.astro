---
import Layout from '@/components/Layout.astro';
import CityList from '@/components/islands/CityList';
import { getCities } from '@/lib/shows';

const cities = await getCities();
---

<Layout title="Shows by City">
  <div class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="text-3xl font-bold text-dead-gold mb-2">Shows by City</h1>
    <p class="text-gray-400 mb-6">{cities.length} cities across the globe</p>
    <CityList cities={cities} client:load />
  </div>
</Layout>
